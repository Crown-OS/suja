// Copy to ~/.config/crownos/suja.ron and edit. Every field is optional.
(
    // The chord sujad asks the compositor for: tap it for the assistant, hold it to talk.
    // The compositor can give a different chord, and the user can change it in Settings.
    hotkey: "Super",
    model_file: "Qwen3-4B-Instruct-2507-Q4_K_M.gguf",
    stt_model_dir: "sherpa-onnx-streaming-zipformer-en-2023-06-26",
    tts: (
        // "pocket" (reference voice wav) or "kokoro" (speaker id in `voice`)
        backend: "pocket",
        model_dir: "sherpa-onnx-pocket-tts-int8-2026-01-26",
        voice: "test_wavs/bria.wav",
        speed: 1.0,
        threads: 4,
    ),
    // Web search needs one of these.
    searxng_url: None,
    brave_api_key: None,
    // Override the shell allow list if you like.
    allowed_commands: None,
    idle_reset_seconds: 180,
    min_free_vram_mib: 4500,
)
