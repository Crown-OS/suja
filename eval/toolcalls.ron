// Tool-selection eval for the M1 gate. Each prompt is a fresh conversation.
// `expect` is the tool the first assistant action must call, or NoTool.
(
    cases: [
        (prompt: "how much free disk space do I have", expect: Tool("run_command")),
        (prompt: "what's eating my memory right now", expect: Tool("run_command")),
        (prompt: "is pipewire running", expect: Tool("run_command")),
        (prompt: "what's the git status of my current project in ~/code/suja", expect: Tool("run_command")),
        (prompt: "how long has this laptop been up", expect: Tool("run_command")),
        (prompt: "which kernel am I running", expect: Tool("run_command")),
        (prompt: "read my todo file in the home folder", expect: Tool("read_file")),
        (prompt: "open ~/Notes/ideas.md and tell me what's in it", expect: Tool("read_file")),
        (prompt: "find files about taxes in my documents", expect: Tool("search_files")),
        (prompt: "where did I save that invoice pdf", expect: Tool("search_files")),
        (prompt: "remind me to call mom tomorrow, save that as a note", expect: Tool("save_note")),
        (prompt: "note down: buy oat milk and coffee", expect: Tool("save_note")),
        (prompt: "turn the volume down a bit", expect: Tool("adjust_setting")),
        (prompt: "set brightness to forty percent", expect: Tool("adjust_setting")),
        (prompt: "mute the speakers", expect: Tool("adjust_setting")),
        (prompt: "pause the music", expect: Tool("media_control")),
        (prompt: "skip this song", expect: Tool("media_control")),
        (prompt: "what's playing right now", expect: Tool("media_control")),
        (prompt: "set a timer for ten minutes", expect: Tool("set_timer")),
        (prompt: "wake me in an hour", expect: Tool("set_timer")),
        (prompt: "who won the champions league final this year", expect: Tool("web_search")),
        (prompt: "what's the weather in Chennai today", expect: Tool("web_search")),
        (prompt: "look up the latest rust release notes", expect: Tool("web_search")),
        (prompt: "summarize this page https://example.com/article", expect: Tool("web_fetch")),
        (prompt: "run the command echo done > /tmp/suja-test", expect: Tool("run_command")),
        (prompt: "delete the file old-notes.txt in my home folder", expect: Tool("run_command")),
        (prompt: "what time is it", expect: NoTool),
        (prompt: "hey, how are you doing", expect: NoTool),
        (prompt: "what is the capital of France", expect: NoTool),
        (prompt: "explain what a mutex is in one sentence", expect: NoTool),
        (prompt: "tell me a short joke", expect: NoTool),
        (prompt: "thanks, that's all", expect: NoTool),
    ],
)
